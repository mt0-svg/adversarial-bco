public import Mathlib.Probability.Independence.InfinitePi
public import Mathlib.Probability.ConditionalExpectation
public import Mathlib.Analysis.Complex.ExponentialBounds

@[expose] public section

/-!
# Sanity checks of the statement `TheoremUnified` (StatementUnified.lean, StatementBitRAMO.lean)

The theorems stated in the challenge (ChallengeUnified.lean) next to `theoremUnified` are proved here
under the same names, and Comparator checks them against it (config-unified.json).

* The exact membership answer is a weak membership oracle at every precision (`weakMemOracle_exact`); the case
  `B_1 ⊆ K ⊆ B_{2d}` with an evaluated gauge of BJLR26 Theorem 3.1 is therefore an instance of the statement.
* The σ-algebras of the noise clauses are sub-σ-algebras of the σ-algebra of `Ω` (`histσ_le`): the conditional
  expectations of `NoisyAdv` are not Mathlib's junk value `0`, and the independences are between sub-σ-algebras.
* The hypotheses hold together at `d = n = 1`, `δ = 1/2`, `a = 0`, `r0 = R0 = 1`, the closed unit ball, its exact
  membership oracle, and the zero losses with zero noise on the coin space `(ℕ → Bool, coinStream)`, for all windows
  `D`, `D'` (`hyps_satisfiable`).
* The class `NoisyAdv` has members with a nonzero noise in every round: on the space `ℕ ⊕ ℕ → Bool` of fair coins,
  the program's coins at the indices `inl j` and the noise of round `t` equal to `1/2` or `-1/2` according to the coin
  at `inr t`, with the zero losses, for every convex `K`, every `n` and all windows (`noisyAdv_signNoise`).
* The existential is not witnessed for free: the empty program fails the cost clause on every input with `n ≥ 1`
  (`nil_not_costOKO`).
-/

open MeasureTheory ProbabilityTheory

namespace AdversarialBco.Unified.UnifiedSanity

open BitRAM BitRAMO

/-! ## The oracle -/

/-- The exact membership answer is a weak membership oracle for `K` at every precision. -/
theorem weakMemOracle_exact {d : ℕ} (K : Set (E d)) [DecidablePred (· ∈ K)] :
    WeakMemOracle K (fun y _ => decide (toE y ∈ K)) := by
  intro y k
  constructor
  · intro h
    have hy : toE y ∈ K := by simpa using h
    exact ⟨toE y, hy, by rw [dist_self]; positivity⟩
  · intro h hsub
    have hy : toE y ∉ K := by simpa using h
    exact hy (hsub (Metric.mem_closedBall_self (by positivity)))

/-! ## The σ-algebras of the environment -/

/-- Under `NoisyAdv`, the σ-algebra generated by the losses of the rounds below `L ≤ n`, the noises of the rounds below
`M ≤ n` and the coins below any index, and that of the coins from any index on, are sub-σ-algebras of the σ-algebra
of `Ω`. -/
theorem histσ_le {d n : ℕ} {K : Set (E d)} {D D' : ℕ → ℕ} {Ω : Type} [mΩ : MeasurableSpace Ω] {μ : Measure Ω}
    {coin : Ω → ℕ → Bool} {loss : ℕ → Ω → E d → ℝ} {noise : ℕ → Ω → ℝ}
    (h : NoisyAdv K n D D' μ coin loss noise) {L M : ℕ} (hL : L ≤ n) (hM : M ≤ n) (N : ℕ) :
    histσ K loss noise coin L M N ≤ mΩ ∧ coinsFrom coin N ≤ mΩ := by
  have hc : ∀ j, Measurable fun ω => coin ω j := fun j => (measurable_pi_apply j).comp h.coin_meas
  refine ⟨sup_le (sup_le ?_ ?_) ?_, ?_⟩
  · exact iSup₂_le fun s hs => iSup₂_le fun y hy => (h.loss_meas s (by omega) y hy).comap_le
  · exact iSup₂_le fun s hs => (h.noise_meas s (by omega)).comap_le
  · exact iSup₂_le fun j _ => (hc j).comap_le
  · exact iSup₂_le fun j _ => (hc j).comap_le

/-! ## Spaces of fair coins indexed by any type -/

section Coords

variable {ι : Type}

/-- The σ-algebra of the coordinates in `S` of a sequence of coins indexed by `ι`. -/
abbrev coordσ (S : Set ι) : MeasurableSpace (ι → Bool) :=
  ⨆ i ∈ S, MeasurableSpace.comap (fun ω : ι → Bool => ω i) inferInstance

theorem le_coordσ {S : Set ι} {i : ι} (hi : i ∈ S) :
    MeasurableSpace.comap (fun ω : ι → Bool => ω i) inferInstance ≤ coordσ S :=
  le_iSup₂_of_le i hi le_rfl

theorem coordσ_le (S : Set ι) : coordσ S ≤ (inferInstance : MeasurableSpace (ι → Bool)) :=
  iSup₂_le fun i _ => (measurable_pi_apply i).comap_le

/-- Under the product of fair coins, the coordinates in disjoint sets are independent. -/
theorem coordσ_indep {S T : Set ι} (hST : Disjoint S T) :
    Indep (coordσ S) (coordσ T) (Measure.infinitePi fun _ : ι => coinLaw) := by
  have h : iIndep (fun i : ι => MeasurableSpace.comap (fun ω : ι → Bool => ω i) inferInstance)
      (Measure.infinitePi fun _ : ι => coinLaw) :=
    (iIndepFun_iff_iIndep _ _ _).1 (iIndepFun_infinitePi (X := fun _ (b : Bool) => b) (fun _ => measurable_id))
  exact indep_iSup_of_disjoint (fun i => (measurable_pi_apply i).comap_le) h hST

end Coords

/-! ## Non-vacuity -/

/-- The zero losses are admissible on every convex set. -/
theorem admLoss_zero {d : ℕ} {K : Set (E d)} (hK : Convex ℝ K) : AdmLoss K (fun _ => 0) :=
  ⟨convexOn_const 0 hK, fun _ _ => ⟨le_refl 0, zero_le_one⟩⟩

/-- The hypotheses of `TheoremUnified` hold together: `d = n = 1`, `δ = 1/2`, the centre `0`, `r0 = R0 = 1`, the closed
unit ball with its exact membership oracle, and the zero losses with zero noise on the coin space, for all windows. -/
theorem hyps_satisfiable (D D' : ℕ → ℕ) :
    (0 : ℚ) < 1 / 2 ∧ (1 / 2 : ℚ) < 1 ∧ (0 : ℚ) < 1 ∧ (1 : ℚ) ≤ 1 ∧
      IsCompact (Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1) ∧
      Convex ℝ (Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1) ∧
      Metric.closedBall (toE (0 : Fin 1 → ℚ)) ((1 : ℚ) : ℝ) ⊆ Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1 ∧
      Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1 ⊆ Metric.closedBall (toE (0 : Fin 1 → ℚ)) ((1 : ℚ) : ℝ) ∧
      (∃ orc : (Fin 1 → ℚ) → ℕ → Bool, WeakMemOracle (Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1) orc ∧
        ∀ y k, orc y k = true ↔ toE y ∈ Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1) ∧
      NoisyAdv (Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1) 1 D D' coinStream (fun ω => ω)
        (fun _ _ _ => 0) (fun _ _ => 0) := by
  classical
  have hK : Convex ℝ (Metric.closedBall (toE (0 : Fin 1 → ℚ)) (1 : ℝ)) := convex_closedBall _ _
  -- the history σ-algebras of the zero environment are inside the coins below `N`
  have hhist : ∀ L M N, histσ (Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1) (fun _ _ _ => 0) (fun _ _ => 0)
      (fun ω => ω) L M N ≤ coordσ (Set.Iio N) := by
    intro L M N
    refine sup_le (sup_le ?_ ?_) ?_
    · exact iSup₂_le fun _ _ => iSup₂_le fun _ _ => by simp
    · exact iSup₂_le fun _ _ => by simp
    · exact iSup₂_le fun j hj => le_coordσ hj
  have hfrom : ∀ N, coinsFrom (fun ω : ℕ → Bool => ω) N ≤ coordσ (Set.Ici N) :=
    fun N => iSup₂_le fun j hj => le_coordσ hj
  have hind : ∀ L M N, Indep (coinsFrom (fun ω : ℕ → Bool => ω) N)
      (histσ (Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1) (fun _ _ _ => 0) (fun _ _ => 0) (fun ω => ω) L M N)
      coinStream := by
    intro L M N
    have h0 := coordσ_indep (ι := ℕ) (S := Set.Ici N) (T := Set.Iio N)
      (Set.disjoint_left.2 fun j h1 h2 => absurd (Set.mem_Iio.1 h2) (not_lt.2 (Set.mem_Ici.1 h1)))
    exact indep_of_indep_of_le_right (indep_of_indep_of_le_left h0 (hfrom N)) (hhist L M N)
  refine ⟨by norm_num, by norm_num, by norm_num, le_refl _, isCompact_closedBall _ _, hK, by simp, by simp,
    ⟨fun y _ => decide (toE y ∈ Metric.closedBall (toE (0 : Fin 1 → ℚ)) 1), weakMemOracle_exact _,
      fun y k => by simp⟩, ?_⟩
  refine
    { prob := inferInstance
      coin_meas := measurable_id
      coin_law := Measure.map_id'
      adm := fun _ _ _ => admLoss_zero hK
      loss_meas := fun _ _ _ _ => measurable_const
      noise_meas := fun _ _ => measurable_const
      fresh_loss := fun t _ => hind _ _ _
      fresh_noise := fun t _ => hind _ _ _
      noise_int := fun _ _ => integrable_const _
      noise_mean := fun t _ => ?_
      noise_exp := fun t _ => ?_ }
  · have : (fun _ : ℕ → Bool => (0 : ℝ)) = 0 := rfl
    rw [this, condExp_zero]
  · have hle := (hhist (t + 1) t (D' t)).trans (coordσ_le (Set.Iio (D' t)))
    have : (fun ω : ℕ → Bool => Real.exp ((fun _ _ => (0 : ℝ)) t ω ^ 2)) = fun _ => (1 : ℝ) := by
      funext ω; simp
    rw [this, condExp_const hle]
    exact Filter.Eventually.of_forall fun _ => by norm_num

/-- `exp (1/4) ≤ 2`. -/
theorem exp_quarter_le_two : Real.exp (1 / 4) ≤ 2 := by
  calc Real.exp (1 / 4) ≤ Real.exp (Real.log 2) :=
        Real.exp_le_exp.2 (by linarith [Real.log_two_gt_d9])
    _ = 2 := Real.exp_log (by norm_num)

/-- The class has members with a nonzero noise in every round: on the fair coins indexed by `ℕ ⊕ ℕ`, the program's
coins at the indices `inl j`, the noise of round `t` equal to `1/2` or `-1/2` according to the coin at `inr t`, and the
zero losses, for every convex `K`, every `n` and all windows. -/
theorem noisyAdv_signNoise {d : ℕ} (K : Set (E d)) (hK : Convex ℝ K) (n : ℕ) (D D' : ℕ → ℕ) :
    NoisyAdv K n D D' (Measure.infinitePi fun _ : ℕ ⊕ ℕ => coinLaw) (fun ω j => ω (Sum.inl j))
        (fun _ _ _ => 0) (fun t ω => if ω (Sum.inr t) then 1 / 2 else -1 / 2) ∧
      ∀ (t : ℕ) (ω : ℕ ⊕ ℕ → Bool), (if ω (Sum.inr t) then (1 / 2 : ℝ) else -1 / 2) ≠ 0 := by
  classical
  set μ : Measure (ℕ ⊕ ℕ → Bool) := Measure.infinitePi fun _ : ℕ ⊕ ℕ => coinLaw with hμ
  set coin : (ℕ ⊕ ℕ → Bool) → ℕ → Bool := fun ω j => ω (Sum.inl j) with hcoin
  set g : Bool → ℝ := fun b => if b then 1 / 2 else -1 / 2 with hg
  set noise : ℕ → (ℕ ⊕ ℕ → Bool) → ℝ := fun t ω => if ω (Sum.inr t) then 1 / 2 else -1 / 2 with hnoise
  have hnoise_g : ∀ t, noise t = fun ω => g (ω (Sum.inr t)) := fun t => rfl
  -- each noise is measurable for its coordinate
  have hnσ : ∀ t, MeasurableSpace.comap (noise t) inferInstance ≤
      MeasurableSpace.comap (fun ω : ℕ ⊕ ℕ → Bool => ω (Sum.inr t)) inferInstance := by
    intro t
    have hm : Measurable[MeasurableSpace.comap (fun ω : ℕ ⊕ ℕ → Bool => ω (Sum.inr t)) inferInstance] (noise t) :=
      (measurable_from_top (f := g)).comp (comap_measurable _)
    exact hm.comap_le
  -- the history σ-algebras are inside the coordinates `inr s`, `s < M`, and `inl j`, `j < N`
  have hhist : ∀ L M N, histσ K (fun _ _ _ => 0) noise coin L M N ≤
      coordσ (Sum.inr '' Set.Iio M ∪ Sum.inl '' Set.Iio N) := by
    intro L M N
    refine sup_le (sup_le ?_ ?_) ?_
    · exact iSup₂_le fun _ _ => iSup₂_le fun _ _ => by simp
    · exact iSup₂_le fun s hs => (hnσ s).trans (le_coordσ (Or.inl ⟨s, hs, rfl⟩))
    · exact iSup₂_le fun j hj => le_coordσ (Or.inr ⟨j, hj, rfl⟩)
  have hfrom : ∀ N, coinsFrom coin N ≤ coordσ (Sum.inl '' Set.Ici N) :=
    fun N => iSup₂_le fun j hj => le_coordσ ⟨j, hj, rfl⟩
  have hdisj : ∀ M N, Disjoint (Sum.inl '' Set.Ici N : Set (ℕ ⊕ ℕ)) (Sum.inr '' Set.Iio M ∪ Sum.inl '' Set.Iio N) := by
    intro M N
    refine Set.disjoint_left.2 ?_
    rintro _ ⟨j, hj, rfl⟩ (⟨s, _, h⟩ | ⟨j', hj', h⟩)
    · exact Sum.inr_ne_inl h
    · have := Sum.inl.inj h
      subst this
      exact absurd (Set.mem_Iio.1 hj') (not_lt.2 (Set.mem_Ici.1 hj))
  have hind : ∀ L M N, Indep (coinsFrom coin N) (histσ K (fun _ _ _ => 0) noise coin L M N) μ := fun L M N =>
    indep_of_indep_of_le_right (indep_of_indep_of_le_left (coordσ_indep (hdisj M N)) (hfrom N)) (hhist L M N)
  have hle : ∀ L M N, histσ K (fun _ _ _ => 0) noise coin L M N ≤ (inferInstance : MeasurableSpace (ℕ ⊕ ℕ → Bool)) :=
    fun L M N => (hhist L M N).trans (coordσ_le _)
  -- the noise of round `t` is independent of the history before it
  have hindn : ∀ t N, Indep (MeasurableSpace.comap (fun ω : ℕ ⊕ ℕ → Bool => ω (Sum.inr t)) inferInstance)
      (histσ K (fun _ _ _ => 0) noise coin (t + 1) t N) μ := by
    intro t N
    have hd : Disjoint ({Sum.inr t} : Set (ℕ ⊕ ℕ)) (Sum.inr '' Set.Iio t ∪ Sum.inl '' Set.Iio N) := by
      refine Set.disjoint_left.2 ?_
      rintro _ rfl (⟨s, hs, h⟩ | ⟨j, _, h⟩)
      · have := Sum.inr.inj h
        subst this
        exact lt_irrefl _ (Set.mem_Iio.1 hs)
      · exact Sum.inl_ne_inr h
    exact indep_of_indep_of_le_right (indep_of_indep_of_le_left (coordσ_indep hd) (le_coordσ rfl)) (hhist _ _ _)
  -- the mean of the noise is `0`
  have hmean : ∀ t, ∫ ω, noise t ω ∂μ = 0 := by
    intro t
    rw [hnoise_g t]
    have hmap : μ.map (fun ω : ℕ ⊕ ℕ → Bool => ω (Sum.inr t)) = coinLaw := Measure.infinitePi_map_eval _ _
    rw [← integral_map (measurable_pi_apply _).aemeasurable (measurable_from_top (f := g)).aestronglyMeasurable,
      hmap, integral_fintype (Integrable.of_finite)]
    simp [Measure.real, BitRAM.Conj1BitSanity.coinLaw_singleton, hg]
    norm_num
  have hexp : ∀ t, (fun ω => Real.exp (noise t ω ^ 2)) = fun _ => Real.exp (1 / 4) := by
    intro t
    funext ω
    simp only [hnoise]
    split_ifs <;> norm_num
  refine ⟨?_, fun t ω => by split_ifs <;> norm_num⟩
  refine
    { prob := inferInstance
      coin_meas := measurable_pi_iff.2 fun j => measurable_pi_apply _
      coin_law := ?_
      adm := fun _ _ _ => admLoss_zero hK
      loss_meas := fun _ _ _ _ => measurable_const
      noise_meas := fun t _ => (measurable_from_top (f := g)).comp (measurable_pi_apply _)
      fresh_loss := fun t _ => hind _ _ _
      fresh_noise := fun t _ => hind _ _ _
      noise_int := fun t _ => by rw [hexp t]; exact integrable_const _
      noise_mean := fun t _ => ?_
      noise_exp := fun t _ => ?_ }
  · -- the law of the program's coins
    have hm : Measurable coin := measurable_pi_iff.2 fun j => measurable_pi_apply _
    unfold coinStream
    refine Measure.eq_infinitePi _ fun s T hT => ?_
    rw [Measure.map_apply hm (MeasurableSet.pi s.countable_toSet fun i _ => hT i)]
    have hpre : coin ⁻¹' Set.pi (s : Set ℕ) T =
        Set.pi ((s.map Function.Embedding.inl : Finset (ℕ ⊕ ℕ)) : Set (ℕ ⊕ ℕ)) (Sum.elim T fun _ => Set.univ) := by
      ext ω
      simp [hcoin, Set.mem_pi]
    rw [hpre, Measure.infinitePi_pi _ fun i _ => by cases i <;> simp, Finset.prod_map]
    simp
  · -- the noise is centred given the history
    have hsm : StronglyMeasurable[MeasurableSpace.comap (fun ω : ℕ ⊕ ℕ → Bool => ω (Sum.inr t)) inferInstance]
        (noise t) := ((measurable_from_top (f := g)).comp (comap_measurable _)).stronglyMeasurable
    have := condExp_indep_eq ((measurable_pi_apply (Sum.inr t)).comap_le) (hle (t + 1) t (D' t)) hsm
      (hindn t (D' t))
    refine this.trans ?_
    simp only [hmean t]
    rfl
  · rw [hexp t, condExp_const (hle (t + 1) t (D' t))]
    exact Filter.Eventually.of_forall fun _ => exp_quarter_le_two

/-! ## The cost clause -/

/-- The empty program never plays, so it fails the cost clause on every input with `n ≥ 1`. -/
theorem nil_not_costOKO {d : ℕ} (w : WorldO d) (s0 : State d) (n : ℕ) (B : ℝ) (h0 : s0.rounds < n) :
    ¬ CostOKO [] w s0 n B := by
  have hrun : ∀ k, runO [] w s0 k = s0 := by
    intro k
    induction k with
    | zero => rfl
    | succ k ih => rw [runO, Function.iterate_succ_apply', ← runO, ih]; simp [stepO]
  intro h
  obtain ⟨j, hj, -⟩ := h 0 (by rw [hrun]; exact h0)
  rw [hrun, hrun] at hj
  exact lt_irrefl _ hj

end AdversarialBco.Unified.UnifiedSanity
